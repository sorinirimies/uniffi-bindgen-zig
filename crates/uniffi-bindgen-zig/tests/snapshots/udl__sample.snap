    pub extern fn uniffi_sample_checksum_func_risky() callconv(.c) u16;
    pub extern fn uniffi_sample_checksum_func_shape_of() callconv(.c) u16;
    pub extern fn uniffi_sample_checksum_func_use_sink() callconv(.c) u16;
    pub extern fn uniffi_sample_checksum_method_thing_check() callconv(.c) u16;
    pub extern fn uniffi_sample_checksum_method_thing_later() callconv(.c) u16;
    pub extern fn uniffi_sample_checksum_method_thing_name() callconv(.c) u16;
    pub extern fn uniffi_sample_checksum_constructor_thing_new() callconv(.c) u16;
    pub extern fn uniffi_sample_checksum_constructor_thing_other() callconv(.c) u16;
    pub extern fn uniffi_sample_checksum_method_sink_push() callconv(.c) u16;
    pub extern fn uniffi_sample_checksum_method_sink_count() callconv(.c) u16;
    pub extern fn ffi_sample_uniffi_contract_version() callconv(.c) u32;
};

fn bufferFrom(bytes: []const u8) uniffi.RustBuffer {
    var status: uniffi.RustCallStatus = .{};
    const buffer = ffi.ffi_sample_rustbuffer_from_bytes(.{ .len = @intCast(bytes.len), .data = bytes.ptr }, &status);
    if (status.code != uniffi.call_success) @panic("uniffi: could not allocate a RustBuffer");
    return buffer;
}

fn bufferFree(buffer: uniffi.RustBuffer) void {
    var status: uniffi.RustCallStatus = .{};
    ffi.ffi_sample_rustbuffer_free(buffer, &status);
}

var uniffi_initialized: bool = false;
var uniffi_init_mutex: uniffi.Mutex = .{};

/// Checks the library matches these bindings and registers the vtables, once.
pub fn uniffiEnsureInit() void {
    if (@atomicLoad(bool, &uniffi_initialized, .acquire)) return;
    uniffi_init_mutex.lock();
    defer uniffi_init_mutex.unlock();
    if (uniffi_initialized) return;
    if (ffi.ffi_sample_uniffi_contract_version() != 30) @panic("uniffi: sample: contract version mismatch, rebuild the bindings for this library");
    if (ffi.uniffi_sample_checksum_func_add() != 11862) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_func_counts() != 60382) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_func_fetch() != 14633) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_func_lend() != 43746) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_func_names() != 53557) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_func_reverse() != 65335) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_func_risky() != 864) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_func_shape_of() != 5943) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_func_use_sink() != 24362) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_method_thing_check() != 48297) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_method_thing_later() != 11508) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_method_thing_name() != 20614) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_constructor_thing_new() != 10643) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_constructor_thing_other() != 57531) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_method_sink_push() != 59920) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    if (ffi.uniffi_sample_checksum_method_sink_count() != 31664) @panic("uniffi: sample: API checksum mismatch, rebuild the bindings and the library together");
    sinkInit();
    @atomicStore(bool, &uniffi_initialized, true, .release);
}

// ---- Serialization ----

pub fn uniffiWritePoint(w: *uniffi.Writer, v: Point) void {
    w.float64(v.x);
    w.float64(v.y);
    writeOptionString(w, v.label);
    uniffiWriteColor(w, v.color);
}

pub fn uniffiReadPoint(r: *uniffi.Reader, a: std.mem.Allocator) uniffi.Error!Point {
    var v: Point = undefined;
    v.x = try r.float64();
    v.y = try r.float64();
    v.label = try readOptionString(r, a);
    errdefer freeOptionString(a, v.label);
    v.color = try uniffiReadColor(r, a);
    return v;
}

pub fn uniffiWriteColor(w: *uniffi.Writer, v: Color) void {
    switch (v) {
        .red => w.int(i32, 1),
        .green => w.int(i32, 2),
    }
}

pub fn uniffiReadColor(r: *uniffi.Reader, a: std.mem.Allocator) uniffi.Error!Color {
    _ = a;
    return switch (try r.int(i32)) {
        1 => .red,
        2 => .green,
        else => error.Internal,
    };
}

pub fn uniffiWriteDetailed(w: *uniffi.Writer, v: Detailed) void {
    switch (v) {
        .code => |x| {
            w.int(i32, 1);
            w.int(i32, x.code);
        },
        .empty => w.int(i32, 2),
    }
}

pub fn uniffiReadDetailed(r: *uniffi.Reader, a: std.mem.Allocator) uniffi.Error!Detailed {
    _ = a;
    return switch (try r.int(i32)) {
        1 => blk: {
            const f0 = try r.int(i32);
            break :blk .{ .code = .{ .code = f0, } };
        },
        2 => .empty,
        else => error.Internal,
    };
}

pub fn uniffiWriteOops(w: *uniffi.Writer, v: Oops) void {
    switch (v) {
        .bad => w.int(i32, 1),
        .worse => w.int(i32, 2),
    }
}

pub fn uniffiReadOops(r: *uniffi.Reader, a: std.mem.Allocator) uniffi.Error!Oops {
    return switch (try r.int(i32)) {
        1 => .{ .bad = try r.string(a) },
        2 => .{ .worse = try r.string(a) },
        else => error.Internal,
    };
}

pub fn uniffiWriteShape(w: *uniffi.Writer, v: Shape) void {
    switch (v) {
        .circle => |x| {
            w.int(i32, 1);
            uniffiWritePoint(w, x.center);
            w.float64(x.radius);
        },
        .empty => w.int(i32, 2),
    }
}

pub fn uniffiReadShape(r: *uniffi.Reader, a: std.mem.Allocator) uniffi.Error!Shape {
    return switch (try r.int(i32)) {
        1 => blk: {
            const f0 = try uniffiReadPoint(r, a);
            errdefer f0.deinit(a);
            const f1 = try r.float64();
            break :blk .{ .circle = .{ .center = f0, .radius = f1, } };
        },
        2 => .empty,
        else => error.Internal,
    };
}

pub fn uniffiWriteThing(w: *uniffi.Writer, v: Thing) void {
    w.int(u64, v.uniffiLower());
}

pub fn uniffiReadThing(r: *uniffi.Reader, a: std.mem.Allocator) uniffi.Error!Thing {
    _ = a;
    return Thing{ .handle = try r.int(u64) };
}

pub fn uniffiWriteSink(w: *uniffi.Writer, v: Sink) void {
    w.int(u64, Sink.uniffiLower(v));
}

pub fn uniffiReadSink(r: *uniffi.Reader, a: std.mem.Allocator) uniffi.Error!Sink {
    _ = a;
    return Sink.uniffiLift(try r.int(u64));
}

fn writeOptionString(w: *uniffi.Writer, v: ?[]const u8) void {
    if (v) |x| {
        w.int(i8, 1);
        w.string(x);
    } else w.int(i8, 0);
}

fn readOptionString(r: *uniffi.Reader, a: std.mem.Allocator) uniffi.Error!?[]const u8 {
    return switch (try r.int(i8)) {
        0 => null,
        1 => try r.string(a),
        else => error.Internal,
    };
}

fn freeOptionString(a: std.mem.Allocator, v: ?[]const u8) void {
    if (v) |x| a.free(x);
}

fn writeSequenceString(w: *uniffi.Writer, v: []const []const u8) void {
    w.len(v.len);
    for (v) |x| {
        w.string(x);
    }
}

fn readSequenceString(r: *uniffi.Reader, a: std.mem.Allocator) uniffi.Error![]const []const u8 {
    const n = try r.len(4);
    const items = try a.alloc([]const u8, n);
    errdefer a.free(items);
    var done: usize = 0;
    errdefer for (items[0..done]) |x| {
        a.free(x);
    };
    while (done < n) : (done += 1) {
        items[done] = try r.string(a);
    }
    return items;
}

fn freeSequenceString(a: std.mem.Allocator, v: []const []const u8) void {
    for (v) |x| a.free(x);
    a.free(v);
}

fn writeMapStringU32(w: *uniffi.Writer, v: []const uniffi.Entry([]const u8, u32)) void {
    w.len(v.len);
    for (v) |e| {
        w.string(e.key);
        w.int(u32, e.value);
    }
}

fn readMapStringU32(r: *uniffi.Reader, a: std.mem.Allocator) uniffi.Error![]const uniffi.Entry([]const u8, u32) {
    const n = try r.len(8);
    const items = try a.alloc(uniffi.Entry([]const u8, u32), n);
    errdefer a.free(items);
    var done: usize = 0;
    errdefer for (items[0..done]) |e| { a.free(e.key); };
    while (done < n) : (done += 1) {
        const key = try r.string(a);
        items[done] = .{ .key = key, .value = try r.int(u32) };
    }
    return items;
}

fn freeMapStringU32(a: std.mem.Allocator, v: []const uniffi.Entry([]const u8, u32)) void {
    for (v) |e| { a.free(e.key); }
    a.free(v);
}

fn lowerString(v: []const u8) uniffi.RustBuffer {
    return bufferFrom(v);
}

fn liftString(a: std.mem.Allocator, buffer: uniffi.RustBuffer) uniffi.Error![]const u8 {
    defer bufferFree(buffer);
    const data = buffer.data orelse return try a.dupe(u8, "");
    return try a.dupe(u8, data[0..@intCast(buffer.len)]);
}

fn lowerBytes(v: []const u8) uniffi.RustBuffer {
    var writer: uniffi.Writer = .{};
    defer writer.deinit();
    const w = &writer;
    w.string(v);
    return bufferFrom(writer.list.items);
}

fn liftBytes(a: std.mem.Allocator, buffer: uniffi.RustBuffer) uniffi.Error![]const u8 {
    defer bufferFree(buffer);
    const data: []const u8 = if (buffer.data) |d| d[0..@intCast(buffer.len)] else &.{};
    var reader: uniffi.Reader = .{ .data = data };
    const r = &reader;
    const v = try r.string(a);
    if (r.remaining() != 0) return error.Internal;
    return v;
}

fn lowerPoint(v: Point) uniffi.RustBuffer {
    var writer: uniffi.Writer = .{};
    defer writer.deinit();
    const w = &writer;
    uniffiWritePoint(w, v);
    return bufferFrom(writer.list.items);
}

fn liftPoint(a: std.mem.Allocator, buffer: uniffi.RustBuffer) uniffi.Error!Point {
    defer bufferFree(buffer);
    const data: []const u8 = if (buffer.data) |d| d[0..@intCast(buffer.len)] else &.{};
    var reader: uniffi.Reader = .{ .data = data };
