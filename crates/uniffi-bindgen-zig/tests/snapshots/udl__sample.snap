const SinkImpl = struct {
    ptr: *anyopaque,
    vtable: *const Sink.VTable,
};

var sink_handles: uniffi.HandleMap(SinkImpl) = .{};

fn sinkFree(handle: u64) callconv(.c) void {
    _ = sink_handles.remove(handle);
}

fn sinkClone(handle: u64) callconv(.c) u64 {
    return sink_handles.clone(handle);
}

fn sinkM0(uniffi_handle: u64, arg0: uniffi.RustBuffer, uniffi_out_return: ?*anyopaque, uniffi_call_status: *uniffi.RustCallStatus) callconv(.c) void {
    _ = uniffi_out_return;
    const impl = sink_handles.get(uniffi_handle) orelse return uniffi.callbackPanic(uniffi_call_status, "the object was released already", bufferFrom);
    const a = uniffi.allocator;
    const a0 = liftString(a, arg0) catch return uniffi.callbackPanic(uniffi_call_status, "could not read an argument", bufferFrom);
    defer a.free(a0);
    impl.vtable.push(impl.ptr, a, a0) catch |e| {
        uniffi.callbackPanic(uniffi_call_status, @errorName(e), bufferFrom);
        return;
    };
}

fn sinkM1(uniffi_handle: u64, uniffi_out_return: *u32, uniffi_call_status: *uniffi.RustCallStatus) callconv(.c) void {
    const impl = sink_handles.get(uniffi_handle) orelse return uniffi.callbackPanic(uniffi_call_status, "the object was released already", bufferFrom);
    const a = uniffi.allocator;
    var err_value: ?Oops = null;
    const result = impl.vtable.count(impl.ptr, a, &err_value) catch |e| {
        if (err_value) |ev| {
            uniffi_call_status.code = uniffi.call_error;
            uniffi_call_status.error_buf = lowerOops(ev);
            ev.deinit(a);
            return;
        }
        uniffi.callbackPanic(uniffi_call_status, @errorName(e), bufferFrom);
        return;
    };
    uniffi_out_return.* = result;
}

var sink_ffi_vtable: ffi.VTableCallbackInterfaceSink = .{ .uniffi_free = sinkFree, .uniffi_clone = sinkClone, .push = sinkM0, .count = sinkM1 };

fn sinkInit() void {
    ffi.uniffi_sample_fn_init_callback_vtable_sink(&sink_ffi_vtable);
}
